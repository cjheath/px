{
  "fileTypes": [
    
  ],
  "name": "Highlight_test",
  "patterns": [
    {
      "include": "#keyword"
    },
    {
      "include": "#number"
    },
    {
      "include": "#escape"
    },
    {
      "include": "#string"
    },
    {
      "include": "#blockComment"
    }
  ],
  "repository": {
    "blockComment": {
      "begin": "\\\/\\*",
      "end": "\\*\\\/",
      "name": "comment.block.px"
    },
    "escape": {
      "match": "\\\\[\"\\\\ntr]",
      "name": "constant.character.escape.px"
    },
    "keyword": {
      "match": "(?:if|else|while)",
      "name": "keyword.control.px"
    },
    "number": {
      "match": "[0-9]+(?:\\.[0-9]+)?",
      "name": "constant.numeric.px"
    },
    "string": {
      "begin": "[\"]",
      "end": "[\"]",
      "name": "string.quoted.double.px",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    }
  },
  "scopeName": "source.highlight_test"
}
